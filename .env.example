# Copy to .env (or enter as stack env vars in Portainer). Never commit .env.

# Admin password for the Pi-hole web UI (http://<pi-ip>:8081/admin)
PIHOLE_PASSWORD=

# Where Pi-hole keeps its state on the host. Put it somewhere that gets
# backed up; the default is a folder next to this compose file.
PIHOLE_CONFIG_DIR=./etc-pihole

TZ=America/Chicago
